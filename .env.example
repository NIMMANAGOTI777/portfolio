# Supabase Credentials
# Retrieve these from your Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# EmailJS Configuration
# Retrieve these from your EmailJS dashboard
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID_ADMIN=your_admin_notification_template_id
VITE_EMAILJS_TEMPLATE_ID_VISITOR=your_visitor_autoreply_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# WhatsApp Integration
# WhatsApp number in international format (exclude +, 00, or spaces; e.g. 15550199228)
VITE_WHATSAPP_NUMBER=1234567890
